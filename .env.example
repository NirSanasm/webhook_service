## Webhook Delivery Lab — Environment Configuration
## Copy to .env and fill in values before running.
## NEVER commit the .env file to version control.

## ============================================================
## WARNING: These are development defaults.
## Change ALL passwords and secrets before any public deployment.
## ============================================================

# Application
APP_NAME=webhook-delivery-lab
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# PostgreSQL
POSTGRES_DB=webhookdb
POSTGRES_USER=webhook
POSTGRES_PASSWORD=webhook_dev_secret
DATABASE_URL=postgresql+asyncpg://webhook:webhook_dev_secret@postgres:5432/webhookdb
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# RabbitMQ
RABBITMQ_DEFAULT_USER=webhook
RABBITMQ_DEFAULT_PASS=webhook_dev_secret
RABBITMQ_URL=amqp://webhook:webhook_dev_secret@rabbitmq:5672/
RABBITMQ_PREFETCH_COUNT=10

# Worker
WORKER_CONCURRENCY=5
WORKER_ID=worker-1

# Delivery configuration
DELIVERY_TIMEOUT_SECONDS=30.0
DELIVERY_MAX_ATTEMPTS=5

# Outbox publisher
OUTBOX_POLL_INTERVAL_SECONDS=5.0
OUTBOX_BATCH_SIZE=50

# SSRF protection — must be a JSON array of allowed URL prefixes
# pydantic-settings 2.x requires list-typed env vars to be JSON-encoded
ALLOWED_ENDPOINT_PREFIXES=["http://receiver","http://localhost:8001","http://127.0.0.1:8001"]

# OpenTelemetry
OTEL_ENDPOINT=http://otel-collector:4317
OTEL_ENABLED=true
OTEL_SERVICE_NAME=webhook-api

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=grafana_dev_secret
GF_SERVER_DOMAIN=localhost
GF_SERVER_ROOT_URL=http://localhost:3000

# Mock Receiver
RECEIVER_FLAKY_FAIL_COUNT=3
RECEIVER_SLOW_DELAY_SECONDS=10.0
RECEIVER_RATE_LIMIT_WAIT_SECONDS=5
RECEIVER_TIMEOUT_DELAY_SECONDS=60.0

